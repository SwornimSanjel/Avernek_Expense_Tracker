# Copy this file to ".env.local" and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: SERVER ONLY. Never expose to the browser.
# Used by the daily FX cron job and admin backfills.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A random secret protecting the /api/cron/fx endpoint.
# Generate with:  openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
