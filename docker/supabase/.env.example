# Self-hosted Supabase configuration.
#
#   cp .env.example .env
#   python3 scripts/supabase-keys.py     # paste the four generated values below
#   chmod 600 .env
#
# This file is the whole security boundary of the stack. Never commit the real
# .env -- POSTGRES_PASSWORD and SERVICE_ROLE_KEY together are full database access.

# -----------------------------------------------------------------------------
# Secrets — from scripts/supabase-keys.py
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# How long a user's access token stays valid, in seconds (1 hour).
JWT_EXPIRY=3600

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Where this stack is reachable. Must match the Caddy site block, and must be
# https -- browsers refuse to send auth cookies to a bare-http cross origin.
SUPABASE_PUBLIC_URL=https://supabase.avernek.com

# The app. This is the fallback for any redirect not in the allow list below,
# and the base URL embedded in magic-link emails.
SITE_URL=https://expenses.avernek.com

# The redirect allow list — the self-hosted equivalent of the dashboard setting
# that was sending sign-ins to Netlify. Comma-separated, wildcards allowed.
ADDITIONAL_REDIRECT_URLS=https://expenses.avernek.com/**,http://localhost:3000/**

# -----------------------------------------------------------------------------
# Sign-up policy
# -----------------------------------------------------------------------------
# true locks the instance to existing users; invite new ones from Studio.
# Sensible for an internal tool once the team is onboarded.
DISABLE_SIGNUP=false

# true skips email confirmation. Leave false: true means anyone who can guess an
# address gets an account.
MAILER_AUTOCONFIRM=false

# -----------------------------------------------------------------------------
# SMTP — REQUIRED for magic links
# -----------------------------------------------------------------------------
# Hosted Supabase included a shared mailer. Self-hosted, there is none: with
# these blank, "Email me a sign-in link" silently sends nothing.
#
# Any provider works (Resend, Postmark, SES, Gmail app password). The sender
# domain should have SPF/DKIM or the links land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@avernek.com
SMTP_SENDER_NAME=Avernek Expense Tracker

# -----------------------------------------------------------------------------
# Google OAuth — for the "Continue with Google" button
# -----------------------------------------------------------------------------
# In Google Cloud Console, the Authorised redirect URI must be exactly:
#   https://supabase.avernek.com/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Host ports — loopback only; Caddy is the sole entry point
# -----------------------------------------------------------------------------
SUPABASE_DB_PORT=5433
SUPABASE_AUTH_PORT=9999
SUPABASE_REST_PORT=3005
SUPABASE_STUDIO_PORT=3006

# -----------------------------------------------------------------------------
# Studio (admin panel) cosmetics
# -----------------------------------------------------------------------------
STUDIO_ORG_NAME=Avernek
STUDIO_PROJECT_NAME=Expense Tracker
