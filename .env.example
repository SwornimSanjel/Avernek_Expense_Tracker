# Avernek Expense Tracker: runtime configuration.
#
# Production: this file lives at /srv/deployments/avernek-expense-tracker/.env
# (owner jenkins, mode 600). The pipeline never overwrites it silently; see
# docs/DEPLOYMENT.md. Local development: cp .env.example .env && chmod 600 .env
#
# Every value is read at RUNTIME; nothing is compiled into the image. Change a
# value, then `./deploy-control.sh recreate`, and it is live.
#
# Docker Compose expands $VAR inside values. If a secret contains "$", wrap the
# value in single quotes:  POSTGRES_PASSWORD='pa$$word'

# -----------------------------------------------------------------------------
# Host port (required in production)
# -----------------------------------------------------------------------------
# The app is published on 127.0.0.1:<APP_PORT> for Caddy to proxy to. There is
# no default: choose a port no other application on the VPS uses, and check it
# with `ss -ltn "sport = :<port>"` before the first deployment. The earlier
# deployment of this app used 3001.
APP_PORT=

# Optional: the public URL. When set, the post-deploy check also requests
# <PUBLIC_URL>/api/health through Caddy (a failure there is reported as a
# warning: a proxy or DNS problem is not fixed by rolling back the app).
PUBLIC_URL=https://expenses.avernek.com

# -----------------------------------------------------------------------------
# Database: the app's own Postgres container
# -----------------------------------------------------------------------------
# The host is `db`, the Compose service name. These must agree with the
# POSTGRES_* values below.
DATABASE_URL=postgres://avernek:CHANGE_ME@db:5432/avernek

# Initialise the database on its FIRST start only (when the volume is empty).
# Changing them later does not rename the role or database.
POSTGRES_USER=avernek
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=avernek

# "true" only for a managed provider whose certificate is not in Node's trust
# store. The bundled Postgres is on a private network: leave false.
DATABASE_SSL=false

# DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Signs the session cookie. At least 32 characters:  openssl rand -hex 32
# Changing it signs everyone out (which is also how to revoke every session).
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Administrator: created or updated on every deployment (seed-admin.mjs)
# -----------------------------------------------------------------------------
# Each deployment resets this account's password to ADMIN_PASSWORD, so this is
# also the recovery path for a lost password. At least 10 characters.
ADMIN_EMAIL=admin@avernek.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
# Guards /api/cron/fx, the daily NRB exchange-rate refresh:  openssl rand -hex 32
CRON_SECRET=
# When the fx-cron container calls it (cron syntax, UTC). 04:00 UTC = 09:45 NPT.
# FX_CRON_SCHEDULE=0 4 * * *
