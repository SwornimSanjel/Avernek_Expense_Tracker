# Avernek Expense Tracker — configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Every value here is read at RUNTIME. There are no NEXT_PUBLIC_* variables, so
# nothing is compiled into the image: change a value, restart, and it is live.
# No rebuild required.

# -----------------------------------------------------------------------------
# Database — the app connects straight to Postgres
# -----------------------------------------------------------------------------
# Under docker compose the host is `db`, the service name, resolved on the
# compose network. 127.0.0.1 inside a container is the container itself.
DATABASE_URL=postgres://avernek:CHANGE_ME@db:5432/avernek

# These initialise the compose Postgres and MUST match DATABASE_URL. They apply
# only on first start, when the data directory is created.
POSTGRES_USER=avernek
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=avernek

# Set to "true" for a managed provider whose certificate is not in Node's trust
# store. Keeps the transport encrypted without demanding a verifiable chain.
DATABASE_SSL=false

# DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Signs the session cookie. At least 32 characters:
#   openssl rand -hex 32
# Changing it signs everyone out, which is also how you revoke every session.
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Administrator — created by `node scripts/seed-admin.mjs`
# -----------------------------------------------------------------------------
# Re-running the seed resets this password, so it is also the recovery path.
ADMIN_EMAIL=admin@avernek.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
# Guards /api/cron/fx, the daily NRB exchange-rate refresh.
CRON_SECRET=
